<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType><RootNamespace>AppFletesMueve</RootNamespace><UseMaui>true</UseMaui><SingleProject>true</SingleProject><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator><ApplicationTitle>AppFletesMueve</ApplicationTitle><ApplicationId>com.companyname.appfletesmueve</ApplicationId><ApplicationDisplayVersion>1.0</ApplicationDisplayVersion><ApplicationVersion>1</ApplicationVersion><WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion><SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion><SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion><SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion><TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat><UserSecretsId>3b428f2f-2d36-4fc5-94a5-bd8e0cb5c95b</UserSecretsId>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <AndroidManifestPlaceholders>googleMapsApiKey=$(MueveGoogleMapsAndroidKey)</AndroidManifestPlaceholders>
    <AndroidSigningKeyStore Condition="'$(MueveAndroidKeyStore)' != ''">$(MueveAndroidKeyStore)</AndroidSigningKeyStore><AndroidSigningStorePass Condition="'$(MueveAndroidStorePassword)' != ''">$(MueveAndroidStorePassword)</AndroidSigningStorePass><AndroidSigningKeyAlias Condition="'$(MueveAndroidKeyAlias)' != ''">$(MueveAndroidKeyAlias)</AndroidSigningKeyAlias><AndroidSigningKeyPass Condition="'$(MueveAndroidKeyPassword)' != ''">$(MueveAndroidKeyPassword)</AndroidSigningKeyPass>
  </PropertyGroup>
  <Target Name="ValidateReleaseSecrets" BeforeTargets="SignAndroidPackage" Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' == 'net10.0-android'">
    <Error Condition="'$(MueveGoogleMapsAndroidKey)' == ''" Text="Falta MueveGoogleMapsAndroidKey para compilar Android Release." /><Error Condition="'$(MueveAndroidKeyStore)' == '' or '$(MueveAndroidStorePassword)' == '' or '$(MueveAndroidKeyAlias)' == '' or '$(MueveAndroidKeyPassword)' == ''" Text="Faltan propiedades de firma Android para compilar Release." />
  </Target>
  <ItemGroup><MauiIcon Include="Resources\AppIcon\mueve_icon.png" /><MauiSplashScreen Include="Resources\AppIcon\mueve_icon.png" Color="#E65100" BaseSize="256,256" /><MauiImage Include="Resources\Images\*" /><MauiFont Include="Resources\Fonts\*" /><MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" /><PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" /><PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" /><PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" /><PackageReference Include="Microsoft.Maui.Controls.Maps" Version="10.0.110" /></ItemGroup>
  <ItemGroup><MauiXaml Update="Views\CompletarPerfilConductorPage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml><MauiXaml Update="Views\HomeCliente.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml><MauiXaml Update="Views\HomeConductor.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml><MauiXaml Update="Views\LoginPage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml><MauiXaml Update="Views\MisVehiculosPage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml><MauiXaml Update="Views\RegistroPage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml><MauiXaml Update="Views\SeleccionarCargaPage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml><MauiXaml Update="Views\ViajeClientePage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml></ItemGroup>
</Project>
