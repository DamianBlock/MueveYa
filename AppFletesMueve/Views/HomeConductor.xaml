<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
    x:Class="AppFletesMueve.Views.HomeConductor"
    BackgroundColor="#F5F5F5"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!-- BARRA SUPERIOR (con Cerrar sesión) -->
        <Grid Grid.Row="0" BackgroundColor="#E65100" Padding="15,10" ColumnDefinitions="*,Auto">
            <Image Grid.Column="0"
                   Source="logo_mueve.png"
                   HeightRequest="40"
                   HorizontalOptions="Start"/>

            <Label Grid.Column="1"
                   Text="Cerrar sesión"
                   TextColor="White"
                   FontAttributes="Bold"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="CerrarSesion_Tapped"/>
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- MAPA A PANTALLA COMPLETA (sin ScrollView encima) -->
        <maps:Map Grid.Row="1" x:Name="mapConductor"/>

        <Label Grid.Row="1"
               Text="Ubicación del Cliente"
               BackgroundColor="#E65100"
               TextColor="White"
               Padding="10,5"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               Margin="10"/>

        <!-- PANEL INFERIOR DESLIZABLE -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            x:Name="panelPrincipal"
            VerticalOptions="End"
            BackgroundColor="White"
            Stroke="#E0E0E0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 24,24,0,0"
            Padding="0">

            <VerticalStackLayout Spacing="0">

                <!-- Cabecera: deslizar o tocar para colapsar / expandir -->
                <VerticalStackLayout
                    HeightRequest="64"
                    Padding="16,10,16,0"
                    Spacing="8"
                    BackgroundColor="White">
                    <VerticalStackLayout.GestureRecognizers>
                        <SwipeGestureRecognizer Direction="Down" Swiped="PanelCabecera_Swiped"/>
                        <SwipeGestureRecognizer Direction="Up" Swiped="PanelCabecera_Swiped"/>
                        <TapGestureRecognizer Tapped="PanelCabecera_Tapped"/>
                    </VerticalStackLayout.GestureRecognizers>

                    <BoxView HeightRequest="4"
                             WidthRequest="40"
                             CornerRadius="2"
                             Color="#D0D0D0"
                             HorizontalOptions="Center"/>

                    <Label Text="Panel del conductor"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="Black"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <ScrollView x:Name="scrollPanel" MaximumHeightRequest="420">
                    <VerticalStackLayout Padding="16,0,16,16" Spacing="12">

                        <!-- SALUDO -->
                        <Label x:Name="lblSaludo"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <!-- ESTADO DEL SERVICIO -->
                        <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                BackgroundColor="#F5F5F5"
                                Padding="15">
                            <VerticalStackLayout Spacing="10">
                                <Label x:Name="lblEstadoServicio"
                                       Text="Fuera de servicio"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="#757575"/>

                                <Button x:Name="btnServicio"
                                        Text="INICIAR"
                                        BackgroundColor="#2E7D32"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        HeightRequest="50"
                                        CornerRadius="12"
                                        Clicked="Servicio_Clicked"/>

                                <Button x:Name="btnMisVehiculos"
                                        Text="Mis vehículos"
                                        BackgroundColor="White"
                                        TextColor="#E65100"
                                        BorderColor="#E65100"
                                        BorderWidth="1"
                                        HeightRequest="50"
                                        CornerRadius="12"
                                        IsVisible="False"
                                        Clicked="MisVehiculos_Clicked"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- DETALLE DEL VIAJE -->
                        <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                BackgroundColor="#F5F5F5"
                                Padding="15">
                            <VerticalStackLayout Spacing="0">

                                <VerticalStackLayout x:Name="contenedorViaje" Spacing="10" IsVisible="False">
                                    <Label x:Name="lblTituloViaje"
                                           Text="Solicitud de Viaje"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           TextColor="#E65100"/>

                                    <Label x:Name="lblCliente" TextColor="Black"/>
                                    <Label x:Name="lblOrigen" TextColor="Black"/>
                                    <Label x:Name="lblDestino" TextColor="Black"/>
                                    <Label x:Name="lblVehiculo" TextColor="Black"/>

                                    <Label x:Name="lblPrecio"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#E65100"/>

                                    <Label x:Name="lblContador"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#2E7D32"
                                           IsVisible="False"/>

                                    <ProgressBar x:Name="barraContador"
                                                 Progress="0"
                                                 ProgressColor="#2E7D32"
                                                 IsVisible="False"/>

                                    <Button x:Name="btnAccion"
                                            Text="ACEPTAR VIAJE"
                                            BackgroundColor="#E65100"
                                            TextColor="White"
                                            CornerRadius="12"
                                            Clicked="AceptarViaje_Clicked"/>

                                    <Button x:Name="btnChatConductor"
                                            Text="Chat con el cliente"
                                            BackgroundColor="White"
                                            TextColor="#E65100"
                                            BorderColor="#E65100"
                                            BorderWidth="1"
                                            CornerRadius="12"
                                            IsVisible="False"
                                            Clicked="ChatItem_Clicked"/>

                                    <Button x:Name="btnCancelarViaje"
                                            Text="Cancelar viaje"
                                            BackgroundColor="White"
                                            TextColor="#C62828"
                                            BorderColor="#C62828"
                                            BorderWidth="1"
                                            CornerRadius="12"
                                            IsVisible="False"
                                            Clicked="CancelarViaje_Clicked"/>
                                </VerticalStackLayout>

                                <Label x:Name="lblSinViajes"
                                       Text="Buscando viajes disponibles..."
                                       TextColor="Gray"
                                       HorizontalOptions="Center"
                                       Margin="0,20"/>

                                <Button x:Name="btnCompletarPerfil"
                                        Text="Completar perfil de conductor"
                                        BackgroundColor="#E65100"
                                        TextColor="White"
                                        CornerRadius="12"
                                        Margin="20,0,20,20"
                                        IsVisible="False"
                                        Clicked="CompletarPerfil_Clicked"/>

                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>