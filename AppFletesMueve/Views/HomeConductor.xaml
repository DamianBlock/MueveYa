<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
    x:Class="AppFletesMueve.Views.HomeConductor"
    BackgroundColor="#F5F5F5"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="15">

            <!-- CABECERA -->
            <Grid BackgroundColor="#E65100" Padding="15,10">
                <Image Source="logo_mueve.png" HeightRequest="40" HorizontalOptions="Start"/>
            </Grid>

            <!-- CABECERA Y SALUDO -->
            <Border Margin="15,10"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    Padding="15">
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Saludo -->
                    <VerticalStackLayout Grid.Column="0">
                        <Label x:Name="lblSaludo"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="Black"/>
                        <Label Text="Panel del conductor"
                               FontSize="14"
                               TextColor="Gray"/>
                    </VerticalStackLayout>

                    <!-- Cerrar sesión -->
                    <Label Grid.Column="1"
                           Text="Cerrar sesión"
                           TextColor="#E65100"
                           FontAttributes="Bold"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CerrarSesion_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>
            <!-- ESTADO DEL SERVICIO -->
            <Border Margin="15,0"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="lblEstadoServicio"
                           Text="Fuera de servicio"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#757575"/>

                    <Button x:Name="btnServicio"
                            Text="INICIAR"
                            BackgroundColor="#2E7D32"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            CornerRadius="12"
                            Clicked="Servicio_Clicked"/>
                </VerticalStackLayout>
            </Border>
            <!-- MAPA CONDUCTOR -->
            <Border Margin="15,0"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Padding="0">
                <Grid HeightRequest="220">
                    <maps:Map x:Name="mapConductor" />
                    <Label Text="Ubicación del Cliente"
                           BackgroundColor="#E65100"
                           TextColor="White"
                           Padding="10,5"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"/>
                </Grid>
            </Border>

            <!-- DETALLE DEL VIAJE -->
            <Border Margin="15,0"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    Padding="15">
                <VerticalStackLayout Spacing="0">

                    <VerticalStackLayout x:Name="contenedorViaje" Spacing="10" IsVisible="False">
                        <Label x:Name="lblTituloViaje"
                               Text="Solicitud de Viaje"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="#E65100"/>

                        <Label x:Name="lblCliente" TextColor="Black"/>
                        <Label x:Name="lblOrigen" TextColor="Black"/>
                        <Label x:Name="lblDestino" TextColor="Black"/>
                        <Label x:Name="lblVehiculo" TextColor="Black"/>

                        <Label x:Name="lblPrecio"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#E65100"/>

                        <Button x:Name="btnAccion"
                                Text="ACEPTAR VIAJE"
                                BackgroundColor="#E65100"
                                TextColor="White"
                                CornerRadius="12"
                                Clicked="AceptarViaje_Clicked"/>
                    </VerticalStackLayout>

                    <Label x:Name="lblSinViajes"
                           Text="Buscando viajes disponibles..."
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           Margin="0,20"/>

                    <Button x:Name="btnCompletarPerfil"
                            Text="Completar perfil de conductor"
                            BackgroundColor="#E65100"
                            TextColor="White"
                            CornerRadius="12"
                            Margin="20,0,20,20"
                            IsVisible="False"
                            Clicked="CompletarPerfil_Clicked"/>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>