<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppFletesMueve.Views.LoginPage"
    BackgroundColor="#D94B05">

    <Grid>
        <Image Source="mueve_login.png" Aspect="AspectFill" />

        <ScrollView>
            <Grid Padding="24,28" RowDefinitions="*,Auto">
                <VerticalStackLayout Grid.Row="1" Spacing="12">
                    <Label
                        Text="Ingresá para continuar"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center" />

                    <Border
                        BackgroundColor="#F2FFFFFF"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        Padding="18">
                        <VerticalStackLayout Spacing="12">
                            <Entry
                                x:Name="txtEmail"
                                Placeholder="Correo electrónico"
                                Keyboard="Email"
                                BackgroundColor="White"
                                TextColor="Black"
                                PlaceholderColor="#757575" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Entry
                                    x:Name="txtPassword"
                                    Grid.Column="0"
                                    Placeholder="Contraseña"
                                    IsPassword="True"
                                    BackgroundColor="White"
                                    TextColor="Black"
                                    PlaceholderColor="#757575" />
                                <Button
                                    x:Name="btnMostrarPassword"
                                    Grid.Column="1"
                                    Text="👁"
                                    FontSize="20"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    TextColor="#555555"
                                    SemanticProperties.Hint="Mostrar contraseña"
                                    Clicked="MostrarPassword_Clicked" />
                            </Grid>

                            <Button
                                Text="INGRESAR"
                                BackgroundColor="#E65100"
                                TextColor="White"
                                FontAttributes="Bold"
                                HeightRequest="54"
                                CornerRadius="12"
                                Clicked="Ingresar_Clicked" />

                            <Button
                                Text="CREAR CUENTA"
                                BackgroundColor="White"
                                BorderColor="#E65100"
                                BorderWidth="2"
                                TextColor="#E65100"
                                FontAttributes="Bold"
                                HeightRequest="52"
                                CornerRadius="12"
                                Clicked="Registro_Clicked" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>

</ContentPage>
