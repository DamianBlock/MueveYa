<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="AppFletesMueve.Views.HomeCliente"
             x:Name="PaginaPrincipal"
             xmlns:models="clr-namespace:AppFletesMueve.Models"
             xmlns:vm="clr-namespace:AppFletesMueve.ViewModels"
             BackgroundColor="#F5F5F5"
             NavigationPage.HasNavigationBar="False">

    <Grid>

        <!-- CONTENIDO NORMAL -->
        <ScrollView>

            <VerticalStackLayout BackgroundColor="#F5F5F5" Spacing="0">

                <!-- BARRA SUPERIOR -->
                <Grid BackgroundColor="#E65100" Padding="15,10" ColumnDefinitions="Auto,*,Auto">

                    <Label
                        Grid.Column="0"
                        Text="&#9776;"
                        FontSize="26"
                        TextColor="White"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AbrirMenu_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Image
                        Grid.Column="1"
                        Source="logo_mueve.png"
                        HeightRequest="40"
                        HorizontalOptions="Center"/>

                    <Label
                        Grid.Column="2"
                        x:Name="lblBienvenida"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="White"
                        VerticalOptions="Center"/>

                </Grid>

                <!-- MAPA, con pin fijo central para elegir ubicación arrastrando -->
                <Grid HeightRequest="220" BackgroundColor="#E0E0E0">

                    <maps:Map x:Name="mapCliente" HeightRequest="220" IsShowingUser="True" />

                    <!-- Pin fijo, decorativo: el usuario mueve el mapa por debajo -->
                    <Image
                        x:Name="pinCentral"
                        Source="pin_naranja.svg"
                        HeightRequest="40"
                        WidthRequest="40"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        IsVisible="False"
                        InputTransparent="True"/>

                    <Button
                        x:Name="btnConfirmarUbicacionMapa"
                        Text="Usar esta ubicación"
                        BackgroundColor="#E65100"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="40"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        Margin="0,0,0,10"
                        IsVisible="False"
                        Clicked="ConfirmarUbicacionMapa_Clicked"/>

                </Grid>

                <!-- BÚSQUEDA DE ORIGEN Y DESTINO -->
                <VerticalStackLayout HorizontalOptions="Fill" VerticalOptions="Start" Padding="12" Spacing="6">

                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                        <Entry
                            x:Name="txtOrigen"
                            Placeholder="Buscar origen..."
                            PlaceholderColor="#757575"
                            TextColor="#000000"
                            Grid.Column="0"
                            BackgroundColor="#FFFFFF"
                            TextChanged="TxtOrigen_TextChanged"/>
                        <Button
                            Text="Buscar"
                            Grid.Column="1"
                            Clicked="BuscarOrigen_Clicked"
                            BackgroundColor="#E65100"
                            TextColor="#FFFFFF"/>
                        <Button
                            Text="📍"
                            Grid.Column="2"
                            Clicked="ElegirOrigenEnMapa_Clicked"
                            BackgroundColor="#FFFFFF"
                            TextColor="#E65100"
                            BorderColor="#E65100"
                            BorderWidth="1"
                            WidthRequest="48"/>
                    </Grid>

                    <CollectionView
                        x:Name="listaSugerenciasOrigen"
                        IsVisible="False"
                        BackgroundColor="White"
                        MaximumHeightRequest="140">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,8">
                                    <Label Text="{Binding Description}" TextColor="Black" FontSize="14"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="SugerenciaOrigen_Tapped"/>
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                        <Entry
                            x:Name="txtDestino"
                            Placeholder="Buscar destino..."
                            TextColor="#000000"
                            Grid.Column="0"
                            BackgroundColor="#FFFFFF"
                            TextChanged="TxtDestino_TextChanged"/>
                        <Button
                            Text="Buscar"
                            Grid.Column="1"
                            Clicked="BuscarDestino_Clicked"
                            BackgroundColor="#E65100"
                            TextColor="White"/>
                        <Button
                            Text="📍"
                            Grid.Column="2"
                            Clicked="ElegirDestinoEnMapa_Clicked"
                            BackgroundColor="#FFFFFF"
                            TextColor="#E65100"
                            BorderColor="#E65100"
                            BorderWidth="1"
                            WidthRequest="48"/>
                    </Grid>

                    <CollectionView
                        x:Name="listaSugerencias"
                        IsVisible="False"
                        BackgroundColor="White"
                        MaximumHeightRequest="140">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,8">
                                    <Label Text="{Binding Description}" TextColor="Black" FontSize="14"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="SugerenciaDestino_Tapped"/>
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>

                <!-- CONTENIDO -->
                <VerticalStackLayout Padding="20" Spacing="15">

                    <Border
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1"
                        Stroke="#E0E0E0"
                        Padding="15"
                        BackgroundColor="#FAFAFA">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Origen" TextColor="Gray" FontSize="12"/>
                            <Label x:Name="lblOrigenResumen" Text="" FontAttributes="Bold" TextColor="Black"/>
                            <Label Text="Destino" TextColor="Gray" FontSize="12"/>
                            <Label x:Name="lblDestinoResumen" Text="" FontAttributes="Bold" TextColor="Black"/>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="¿Qué vas a trasladar?" FontSize="16" FontAttributes="Bold" TextColor="Black"/>

                    <Label x:Name="lblCargaResumen"
                       Text="Todavía no elegiste carga"
                       FontSize="13"
                       TextColor="Gray"/>

                    <Button Text="Elegir / editar carga"
                        BackgroundColor="White"
                        TextColor="#E65100"
                        BorderColor="#E65100"
                        BorderWidth="1"
                        CornerRadius="10"
                        Clicked="ElegirCarga_Clicked"/>

                    <Button x:Name="btnCalcularTarifa"
                        Text="Calcular tarifa"
                        BackgroundColor="#E65100"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="55"
                        CornerRadius="12"
                        Clicked="CalcularTarifa_Clicked"/>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>
        
        <!-- OVERLAY: FONDO DEL SHEET DE COTIZACIÓN -->
        <BoxView
            x:Name="fondoCotizacion"
            BackgroundColor="#80000000"
            IsVisible="False">  
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="CerrarCotizacion_Tapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- BOTTOM SHEET: TARIFAS POR VEHÍCULO -->
        <Border
            x:Name="sheetCotizacion"
            x:DataType="vm:CotizacionViewModel"
            IsVisible="False"
            VerticalOptions="End"
            BackgroundColor="White"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 24,24,0,0"
            Padding="16,10,16,16">

            <VerticalStackLayout Spacing="10">

                <!-- Cabecera: deslizar hacia abajo para cerrar -->
                <VerticalStackLayout Spacing="8">
                    <VerticalStackLayout.GestureRecognizers>
                        <SwipeGestureRecognizer Direction="Down" Swiped="SheetCotizacion_Swiped"/>
                    </VerticalStackLayout.GestureRecognizers>

                    <BoxView HeightRequest="4"
                         WidthRequest="40"
                         CornerRadius="2"
                         Color="#D0D0D0"
                         HorizontalOptions="Center"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Elegí tu vehículo"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="Black"/>
                            <Label Text="{Binding ResumenViaje}"
                           FontSize="12"
                           TextColor="#757575"/>
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                       Text="✕"
                       FontSize="20"
                       Padding="8"
                       TextColor="Gray"
                       VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="CerrarCotizacion_Tapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </VerticalStackLayout>

                <Label Text="{Binding MensajeSinOpciones}"
               IsVisible="{Binding SinOpciones}"
               TextColor="#D32F2F"
               FontSize="13"/>

                <ScrollView MaximumHeightRequest="300">
                    <VerticalStackLayout Spacing="8"
                                 BindableLayout.ItemsSource="{Binding Opciones}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CotizacionVehiculo">
                                <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="2"
                                Stroke="{Binding ColorBorde}"
                                BackgroundColor="{Binding ColorFondo}"
                                Opacity="{Binding Opacidad}"
                                Padding="10">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OpcionVehiculo_Tapped"/>
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="10">

                                        <Image Source="{Binding Imagen}"
                                       HeightRequest="45"
                                       WidthRequest="60"/>

                                        <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center">
                                            <Label Text="{Binding Nombre}"
                                           FontAttributes="Bold"
                                           TextColor="Black"/>
                                            <Label Text="{Binding Detalle}"
                                           FontSize="11"
                                           TextColor="Gray"/>
                                            <Label Text="{Binding Etiqueta}"
                                           IsVisible="{Binding TieneEtiqueta}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{Binding ColorEtiqueta}"/>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2"
                                       Text="{Binding PrecioTexto}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#212121"
                                       VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

                <Button Text="{Binding TextoConfirmar}"
                    IsEnabled="{Binding PuedeConfirmar}"
                    BackgroundColor="#2E7D32"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="12"
                    Clicked="ConfirmarFlete_Clicked"/>
            </VerticalStackLayout>
        </Border>

        <!-- OVERLAY: FONDO OSCURO -->
        <BoxView
            x:Name="fondoOscuro"
            BackgroundColor="#80000000"
            IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="CerrarMenu_Tapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- OVERLAY: PANEL DEL MENÚ -->
        <Border
            x:Name="panelMenu"
            IsVisible="False"
            BackgroundColor="White"
            StrokeThickness="0"
            StrokeShape="Rectangle"
            Padding="0"
            WidthRequest="230"
            HorizontalOptions="Start"
            VerticalOptions="Fill">

            <VerticalStackLayout Padding="20" Spacing="0">

                <Label Text="MUEVE" FontSize="22" FontAttributes="Bold" TextColor="#E65100" Margin="0,10,0,30"/>

                <VerticalStackLayout Spacing="25">

                    <Label Text="Inicio" FontSize="16" TextColor="Black">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CerrarMenu_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Viajes" FontSize="16" TextColor="Black">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Viajes_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Promos" FontSize="16" TextColor="Black">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Promos_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Cerrar Sesión" FontSize="16" TextColor="Black">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CerrarSesion_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>