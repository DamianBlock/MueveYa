<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="AppFletesMueve.Views.HomeCliente"
             x:Name="PaginaPrincipal"
             BackgroundColor="#F5F5F5"
             NavigationPage.HasNavigationBar="False">

    <Grid>

        <!-- CONTENIDO NORMAL -->
        <ScrollView>

            <VerticalStackLayout BackgroundColor="#F5F5F5" Spacing="0">

                <!-- BARRA SUPERIOR -->
                <Grid BackgroundColor="#E65100" Padding="15,10" ColumnDefinitions="Auto,*,Auto">

                    <Label
                        Grid.Column="0"
                        Text="&#9776;"
                        FontSize="26"
                        TextColor="White"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AbrirMenu_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Image
                        Grid.Column="1"
                        Source="logo_mueve.png"
                        HeightRequest="40"
                        HorizontalOptions="Center"/>

                    <Label
                        Grid.Column="2"
                        x:Name="lblBienvenida"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="White"
                        VerticalOptions="Center"/>

                </Grid>

                <!-- MAPA, con pin fijo central para elegir ubicación arrastrando -->
                <Grid HeightRequest="220" BackgroundColor="#E0E0E0">

                    <maps:Map x:Name="mapCliente" HeightRequest="220" IsShowingUser="True" />

                    <!-- Pin fijo, decorativo: el usuario mueve el mapa por debajo -->
                    <Image
                        x:Name="pinCentral"
                        Source="pin_naranja.png"
                        HeightRequest="40"
                        WidthRequest="40"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        IsVisible="False"
                        InputTransparent="True"/>

                    <Button
                        x:Name="btnConfirmarUbicacionMapa"
                        Text="Usar esta ubicación"
                        BackgroundColor="#E65100"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="40"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        Margin="0,0,0,10"
                        IsVisible="False"
                        Clicked="ConfirmarUbicacionMapa_Clicked"/>

                </Grid>

                <!-- BÚSQUEDA DE ORIGEN Y DESTINO -->
                <VerticalStackLayout HorizontalOptions="Fill" VerticalOptions="Start" Padding="12" Spacing="6">

                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                        <Entry
                            x:Name="txtOrigen"
                            Placeholder="Buscar origen..."
                            PlaceholderColor="#757575"
                            TextColor="#000000"
                            Grid.Column="0"
                            BackgroundColor="#FFFFFF"
                            TextChanged="TxtOrigen_TextChanged"/>
                        <Button
                            Text="Buscar"
                            Grid.Column="1"
                            Clicked="BuscarOrigen_Clicked"
                            BackgroundColor="#E65100"
                            TextColor="#FFFFFF"/>
                        <Button
                            Text="📍"
                            Grid.Column="2"
                            Clicked="ElegirOrigenEnMapa_Clicked"
                            BackgroundColor="#FFFFFF"
                            TextColor="#E65100"
                            BorderColor="#E65100"
                            BorderWidth="1"
                            WidthRequest="48"/>
                    </Grid>

                    <CollectionView
                        x:Name="listaSugerenciasOrigen"
                        IsVisible="False"
                        BackgroundColor="White"
                        MaximumHeightRequest="140">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,8">
                                    <Label Text="{Binding Description}" TextColor="Black" FontSize="14"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="SugerenciaOrigen_Tapped"/>
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                        <Entry
                            x:Name="txtDestino"
                            Placeholder="Buscar destino..."
                            TextColor="#000000"
                            Grid.Column="0"
                            BackgroundColor="#FFFFFF"
                            TextChanged="TxtDestino_TextChanged"/>
                        <Button
                            Text="Buscar"
                            Grid.Column="1"
                            Clicked="BuscarDestino_Clicked"
                            BackgroundColor="#E65100"
                            TextColor="White"/>
                        <Button
                            Text="📍"
                            Grid.Column="2"
                            Clicked="ElegirDestinoEnMapa_Clicked"
                            BackgroundColor="#FFFFFF"
                            TextColor="#E65100"
                            BorderColor="#E65100"
                            BorderWidth="1"
                            WidthRequest="48"/>
                    </Grid>

                    <CollectionView
                        x:Name="listaSugerencias"
                        IsVisible="False"
                        BackgroundColor="White"
                        MaximumHeightRequest="140">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,8">
                                    <Label Text="{Binding Description}" TextColor="Black" FontSize="14"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="SugerenciaDestino_Tapped"/>
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>

                <!-- CONTENIDO -->
                <VerticalStackLayout Padding="20" Spacing="15">

                    <Border
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1"
                        Stroke="#E0E0E0"
                        Padding="15"
                        BackgroundColor="#FAFAFA">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Origen" TextColor="Gray" FontSize="12"/>
                            <Label x:Name="lblOrigenResumen" Text="" FontAttributes="Bold" TextColor="Black"/>
                            <Label Text="Destino" TextColor="Gray" FontSize="12"/>
                            <Label x:Name="lblDestinoResumen" Text="" FontAttributes="Bold" TextColor="Black"/>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Selecciona el tipo de carga" FontSize="16" FontAttributes="Bold" TextColor="Black"/>

                    <Button Text="Elegir carga" BackgroundColor="#E65100" TextColor="White" CornerRadius="10" Clicked="ElegirCarga_Clicked"/>

                    <CollectionView
                        ItemsSource="{Binding Vehiculos}"
                        HeightRequest="180"
                        SelectionMode="Single"
                        SelectedItem="{Binding VehiculoSeleccionado}"
                        SelectionChanged="Vehiculos_SelectionChanged">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Stroke="#E65100"
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="140"
                                    Padding="10">

                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="Stroke" Value="#E65100" />
                                                    <Setter Property="StrokeThickness" Value="2" />
                                                    <Setter Property="BackgroundColor" Value="#FFFFFF" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="Stroke" Value="#FFB74D" />
                                                    <Setter Property="StrokeThickness" Value="3" />
                                                    <Setter Property="BackgroundColor" Value="#FFF3E0" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PaginaPrincipal}, Path=BindingContext.SeleccionarVehiculoCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout>
                                        <Image Source="{Binding Imagen}" HeightRequest="60"/>
                                        <Label Text="{Binding Nombre}" FontAttributes="Bold" TextColor="Black" HorizontalTextAlignment="Center"/>
                                        <Label Text="{Binding Precio, StringFormat='${0} MXN'}" TextColor="#E65100" HorizontalTextAlignment="Center"/>
                                        <Button Text="Solicitar" BackgroundColor="#E65100" TextColor="White" CornerRadius="8" CommandParameter="{Binding .}" Clicked="Solicitar_Clicked"/>
                                    </VerticalStackLayout>

                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                    <Button
                        Text="{Binding TextoBotonConfirmar}"
                        Command="{Binding ConfirmarFleteCommand}"
                        BackgroundColor="#E65100"
                        TextColor="White"/>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

        <!-- OVERLAY: FONDO OSCURO -->
        <BoxView
            x:Name="fondoOscuro"
            BackgroundColor="#80000000"
            IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="CerrarMenu_Tapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- OVERLAY: PANEL DEL MENÚ -->
        <Frame
            x:Name="panelMenu"
            IsVisible="False"
            BackgroundColor="White"
            CornerRadius="0"
            Padding="0"
            WidthRequest="230"
            HorizontalOptions="Start"
            VerticalOptions="Fill">

            <VerticalStackLayout Padding="20" Spacing="0">

                <Label Text="MUEVE" FontSize="22" FontAttributes="Bold" TextColor="#E65100" Margin="0,10,0,30"/>

                <VerticalStackLayout Spacing="25">

                    <Label Text="Inicio" FontSize="16" TextColor="Black">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CerrarMenu_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Viajes" FontSize="16" TextColor="Black">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Viajes_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Promos" FontSize="16" TextColor="Black">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Promos_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Cerrar Sesión" FontSize="16" TextColor="Black">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CerrarSesion_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </Frame>

    </Grid>

</ContentPage>