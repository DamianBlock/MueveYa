<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppFletesMueve.Views.CompletarPerfilConductorPage"
    BackgroundColor="#F5F5F5"
    Title="Completar perfil">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Datos de conductor" FontSize="20" FontAttributes="Bold" TextColor="#E65100"/>
            <Entry x:Name="txtLicencia" Placeholder="Número de licencia"/>

            <Label Text="Datos del vehículo" FontSize="18" FontAttributes="Bold" TextColor="#E65100" Margin="0,15,0,0"/>
            <Entry x:Name="txtPatente" Placeholder="Patente (ej: AB123CD)"/>
            <Entry x:Name="txtMarca" Placeholder="Marca"/>
            <Entry x:Name="txtModelo" Placeholder="Modelo"/>
            <Entry x:Name="txtAnio" Placeholder="Año" Keyboard="Numeric"/>

            <Picker x:Name="pickerTipoVehiculo" Title="Tipo de vehículo">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Utilitario</x:String>
                        <x:String>Camioneta</x:String>
                        <x:String>CamionChico</x:String>
                        <x:String>CamionMediano</x:String>
                        <x:String>CamionGrande</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Entry x:Name="txtCapacidadKg" Placeholder="Capacidad de carga (kg)" Keyboard="Numeric"/>
            <Entry x:Name="txtVolumenM3" Placeholder="Volumen (m3)" Keyboard="Numeric"/>

            <Button
                Text="GUARDAR"
                BackgroundColor="#E65100"
                TextColor="White"
                CornerRadius="12"
                Margin="0,20,0,0"
                Clicked="Guardar_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>