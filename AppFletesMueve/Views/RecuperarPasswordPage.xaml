<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppFletesMueve.Views.RecuperarPasswordPage"
    Title="Recuperar contraseña"
    BackgroundColor="#FFF7F2">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="14">
            <Label
                Text="Recuperá tu contraseña"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#E65100" />
            <Label
                Text="Ingresá tu correo. Te enviaremos un código de seis dígitos que vence en 15 minutos."
                TextColor="#4A4A4A" />

            <Entry
                x:Name="txtEmail"
                Placeholder="Correo electrónico"
                Keyboard="Email"
                BackgroundColor="White"
                TextColor="Black"
                PlaceholderColor="#757575" />

            <Button
                Text="ENVIAR CÓDIGO"
                BackgroundColor="#E65100"
                TextColor="White"
                FontAttributes="Bold"
                HeightRequest="52"
                CornerRadius="12"
                Clicked="EnviarCodigo_Clicked" />

            <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,10" />

            <Label
                Text="Cuando recibas el código"
                FontAttributes="Bold"
                TextColor="#333333" />
            <Entry
                x:Name="txtCodigo"
                Placeholder="Código de 6 dígitos"
                Keyboard="Numeric"
                MaxLength="6"
                BackgroundColor="White"
                TextColor="Black"
                PlaceholderColor="#757575" />

            <Grid ColumnDefinitions="*,Auto">
                <Entry
                    x:Name="txtPasswordNueva"
                    Grid.Column="0"
                    Placeholder="Nueva contraseña (mínimo 6 caracteres)"
                    IsPassword="True"
                    BackgroundColor="White"
                    TextColor="Black"
                    PlaceholderColor="#757575" />
                <Button
                    x:Name="btnMostrarPasswordNueva"
                    Grid.Column="1"
                    Text="👁"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="#555555"
                    SemanticProperties.Hint="Mostrar contraseña nueva"
                    Clicked="MostrarPasswordNueva_Clicked" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <Entry
                    x:Name="txtConfirmarPassword"
                    Grid.Column="0"
                    Placeholder="Repetí la nueva contraseña"
                    IsPassword="True"
                    BackgroundColor="White"
                    TextColor="Black"
                    PlaceholderColor="#757575" />
                <Button
                    x:Name="btnMostrarConfirmarPassword"
                    Grid.Column="1"
                    Text="👁"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="#555555"
                    SemanticProperties.Hint="Mostrar contraseña"
                    Clicked="MostrarConfirmarPassword_Clicked" />
            </Grid>

            <Button
                Text="ACTUALIZAR CONTRASEÑA"
                BackgroundColor="#E65100"
                TextColor="White"
                FontAttributes="Bold"
                HeightRequest="52"
                CornerRadius="12"
                Clicked="RestablecerPassword_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
